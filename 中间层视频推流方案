vim ffmpegServer.js
import { spawn } from 'child_process';
function startStreaming(filePath, rtmpUrl) {
  const child = spawn(
    `${ffmpegPath.path} -stream_loop -1 -re -i ${filePath} -c:v libx264 -preset ultrafast -r 10 -f flv ${rtmpUrl}`,
    {
      stdio: 'inherit',
      shell: true,
    },
  );
  child.on('exit', (code) => {
    if (code !== 0) {
      console.error(`FFmpeg process exited with code ${code}`);
    } else {
      console.log('FFmpeg process exited successfully');
    }
  });
  child.on('error', (err) => {
    console.error(`FFmpeg process error: ${err.message}`);
  });
}

